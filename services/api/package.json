{
  "name": "@leroutier/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env.local src/server.js",
    "dev:local": "node --env-file=../../docker/postgres.env src/server.js",
    "build": "node scripts/build.mjs",
    "test": "node --env-file=../../docker/postgres.env --test --test-concurrency=1 tests/*.test.js"
  },
  "dependencies": {
    "@leroutier/database": "workspace:*",
    "@leroutier/domain": "workspace:*",
    "@leroutier/config": "workspace:*",
    "@leroutier/geo": "workspace:*",
    "@leroutier/notifications": "workspace:*",
    "jose": "^6.1.0",
    "@leroutier/agents": "workspace:*",
    "@leroutier/routing": "workspace:*",
    "@leroutier/ussd": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  }
}
