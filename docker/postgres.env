# Local Docker PostgreSQL — deliberately committed.
#
# Everything here addresses a container that only exists on a developer's own
# machine (see compose.yaml). It is not a secret, and committing it is what
# makes `pnpm docker:up && pnpm db:local:migrate` work with no manual setup.
#
# Production and staging credentials are NEVER stored in this repository. They
# live in Vercel (server-side, on le-routier-api) and in an ignored .env.local.
#
# This file is named `postgres.env`, not `.env.something`, on purpose: the
# secret scanner fails the build on any tracked file whose name begins with
# `.env`, and that rule must stay absolute.

DATABASE_URL=postgresql://leroutier:leroutier_local_dev@127.0.0.1:55432/leroutier_dev
# A *_dev schema is required by packages/database/src/guards.js before anything
# may be seeded or dropped. The schema is the environment.
DATABASE_SCHEMA=leroutier_dev
NODE_ENV=development
ALLOW_DEMO_LOGIN=true
CORS_ORIGINS=http://127.0.0.1:4173,http://127.0.0.1:4174,http://127.0.0.1:4175,http://127.0.0.1:4176
