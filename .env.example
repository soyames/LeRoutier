# Runtime
NODE_ENV=development

# Database (Neon/PostgreSQL-compatible)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Registration capacity protection.
#
# The Neon allowance is finite, and running it to zero stops bookings,
# tickets, parcels and payments for EVERY existing user at once. So the
# cheapest thing the platform can refuse — creating a brand new account — is
# refused first, well before the database is actually full.
#
# Only new-account creation is gated. Existing accounts keep signing in, and
# bookings/payments/tickets/parcels keep working after the door closes.
#
# DATABASE_STORAGE_LIMIT_MB   the allowance to measure against, in MB.
#
#   On Neon this does NOT have to be guessed, and should not be. The database
#   publishes the cap its own plan enforces:
#
#       SELECT current_setting('neon.max_cluster_size', true);
#
#   Past that figure Neon makes the database READ-ONLY, so it is the number
#   that matters. Set this variable to it.
#
#   Leaving it empty is safe but not silent: on a database that publishes a
#   cap the protection arms itself from that value and Platform Ops says the
#   limit came from the database; on one that publishes nothing the protection
#   reports itself as NOT ARMED rather than as available capacity.
#
#   A value LARGER than the database will honour is refused as the effective
#   limit — it cannot prop the door open — and Platform Ops shows it as a
#   misconfiguration. A smaller value is honoured as a deliberate margin.
#
# REGISTRATION_STORAGE_STOP_PERCENT  stop new registrations at this usage.
#                             Default 85. Values outside 50..99 are ignored.
# REGISTRATION_ENABLED        set to exactly `false` to close registration
#                             regardless of storage. Anything else is open.
DATABASE_STORAGE_LIMIT_MB=
REGISTRATION_STORAGE_STOP_PERCENT=85
REGISTRATION_ENABLED=true

# Public URLs. There is ONE unified frontend (apps/web); the retired
# passenger/driver/ops apps have no configuration here.
API_URL=http://localhost:4000

# Private object storage for KYC/KYB evidence (Backblaze B2).
#
# Unset keeps the operator-hosted-link arrangement, which is a supported state:
# the product keeps accepting https links and keeps saying plainly that it does
# not hold the documents. A HALF-configured provider produces no store at all
# rather than one that fails on the first upload.
#
# B2_KEY_ID / B2_APPLICATION_KEY must be a BUCKET-SCOPED application key with
# exactly listFiles, readFiles, writeFiles, deleteFiles, shareFiles. Never the
# account's master key: that one can delete buckets and mint further keys.
#
# The bucket must be private. No CORS rule is needed — the reviewer console
# navigates to the signed URL rather than fetching it from JavaScript.
EVIDENCE_STORAGE_PROVIDER=
B2_BUCKET_NAME=
B2_BUCKET_ID=
B2_KEY_ID=
B2_APPLICATION_KEY=

# Mapping/geocoding integrations — configure only when selected
MAP_TILE_URL=
GEOCODING_API_URL=
ROUTING_API_URL=

# Payment provider — FedaPay (collections + driver payouts). Never commit real values.
# Server-only: never prefix with VITE_ and never ship to browser bundles.
PAYMENT_PROVIDER=
# 'sandbox' or 'live'. Production fails closed on anything else — never falls back to sandbox.
FEDAPAY_ENVIRONMENT=
# Collection API key (live: from FedaPay dashboard API section).
FEDAPAY_SECRET_KEY=
# Payout API key. Modelled separately from the collection key; payouts stay
# unavailable when unset. Payouts are an account feature FedaPay enables on request.
FEDAPAY_PAYOUT_SECRET_KEY=
# Distinct per-endpoint webhook signing secret (Workbench → Webhooks). Never reuse an API key.
FEDAPAY_WEBHOOK_SECRET=
# NOTE: FEDAPAY_PUBLIC_KEY is NOT used by LeRoutier — the server-side redirect flow
# (transaction + token) never needs the client-side Checkout.js public key.
# NOTE: there is no FEDAPAY_WEBHOOK_URL. The callback address is registered in the
# FedaPay dashboard and is never sent by this application.

# Driver payouts: Ops approval required by default (no pre-approved policy yet).
PAYOUT_APPROVAL_REQUIRED=true

# USSD channel. Server-side only; nothing USSD-related belongs on the PWA.
# USSD_PROVIDER selects the adapter. Unset means the webhook endpoint does not
# exist at all, and an unrecognised name resolves to NO adapter rather than to
# the sandbox one — a typo must never expose an unverified open endpoint.
USSD_PROVIDER=
USSD_API_KEY=
# HMAC secret for inbound gateway verification. Without it nothing verifies,
# and an unverified callback can never bind an identity.
USSD_WEBHOOK_SECRET=
USSD_SESSION_TTL_SECONDS=180
USSD_DEFAULT_LOCALE=fr
# Whether an MSISDN from a VERIFIED callback may be treated as the caller.
# Opt-in: a gateway signature proves the gateway sent it, not that the person
# owns the account. Even when true, USSD reuses an existing account and never
# creates one.
USSD_TRUST_PROVIDER_MSISDN=false

# Notifications. Channels stay unavailable (never faked as delivered) until the
# matching provider pair is set. in_app needs no provider and always works.
NOTIFICATION_PROVIDER=
NOTIFICATION_API_KEY=
SMS_PROVIDER_URL=
SMS_PROVIDER_KEY=
WHATSAPP_PROVIDER_URL=
WHATSAPP_PROVIDER_KEY=
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_KEY=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=

# Email, spoken directly to a provider instead of through a relay the owner
# would have to run. Set EMAIL_PROVIDER=brevo and the two values below, and
# the email channel becomes available; leave it unset and email stays
# unavailable, which every surface reports honestly rather than dropping
# messages that look delivered.
#
# Brevo because it is the only channel genuinely free for a pilot in Benin
# with no billing activated anywhere: 300 messages a day, no card, full REST
# API on the free tier. SMS to Benin is metered by every provider, and
# WhatsApp needs a Meta Business account and template review.
#
# EXTERNAL ACTION REQUIRED — this cannot be done from the repository:
#   1. create a Brevo account (free plan, no card)
#   2. wait for Brevo to approve the account for sending
#   3. verify the sender address, or the domain, that EMAIL_FROM_ADDRESS uses
#   4. create an API key and set BREVO_API_KEY on le-routier-api (Sensitive)
# See docs/NOTIFICATIONS.md.
EMAIL_PROVIDER=
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=LeRoutier

# First-mile timing policy (minutes). Defaults documented in
# unset uses 20/15/5/10/25.
FIRST_MILE_BOARDING_OPENS_MINUTES=
FIRST_MILE_ARRIVE_BY_MINUTES=
FIRST_MILE_BOARDING_CLOSES_MINUTES=
FIRST_MILE_SAFETY_BUFFER_MINUTES=
FIRST_MILE_DEFAULT_TRAVEL_MINUTES=

# Uncollected parcels. How long a collectable parcel may wait before the
# receiver is reminded, then before the station is asked to act. Operators
# differ; neither threshold is invented in code. Unset uses 24 / 72 hours.
PARCEL_UNCOLLECTED_REMINDER_HOURS=
PARCEL_UNCOLLECTED_ESCALATION_HOURS=

# Agent autonomy: how much a workflow may do without a human.
#   observe            detect and record what it would do; mutate nothing
#   recommend          every mutating step becomes an approval request
#   auto_low_risk      low-risk steps run; privileged/financial still wait
#   approval_required  every step waits for a human
# Unset uses auto_low_risk. An unrecognised value is treated as the SAFEST
# level, never the loosest — a typo must not widen what an agent may do.
# Set AGENT_AUTONOMY_DEFAULT=observe to run the whole agent layer in
# observation for a pilot. Per-workflow overrides are JSON by workflow name,
# e.g. {"breakdown-recovery":"recommend","driver-payout":"approval_required"}.
AGENT_AUTONOMY_DEFAULT=
AGENT_AUTONOMY=

# Model-assisted reasoning. SERVER-SIDE ONLY — never prefix any of these VITE_
# and never place them on the PWA project. Unset means agents stay entirely
# deterministic, which is a supported production state, not a degraded one.
#
# 'gemini', 'openrouter' or 'local'. An unrecognised value selects NO provider
# rather than falling back to a remote one: sending a situation to a third party
# because of a typo would be the wrong default.
AGENT_MODEL_PROVIDER=
# A second chance for low-risk reasoning only, and only when named here. It is
# never inferred from another provider's key being present, because reaching
# for a different third party is a decision about where a situation is sent.
AGENT_MODEL_FALLBACK_PROVIDER=

# Gemini — the primary remote model. Google Gemini Developer API
# (generativelanguage.googleapis.com), authenticated with OAuth.
#
# NOT Vertex AI: that is a different host and requires a billing account.
# There is deliberately no GEMINI_API_KEY path. An API key is a permanent
# bearer secret; a refresh credential mints tokens that expire in an hour and
# can be revoked from the Google account that granted them.
#
# `oauth` is the only implemented mode. Any other value withholds the
# credential and leaves the provider unconfigured, rather than silently
# selecting a different trust model.
GEMINI_AUTH_MODE=oauth
#
# The whole Application Default Credentials document, on one line — the file
# `gcloud auth application-default login` writes. Store it as a SENSITIVE
# variable; it is the one Gemini value whose leak matters.
#
# One value, not three. A credential split across three variables can be
# two-thirds configured: a rotation that updates the secret and forgets the
# refresh token leaves something that looks configured and fails on every call.
# Only an authorized_user document is accepted — a service-account one would
# mean a private key in an environment variable, which is exactly what this
# design avoids. Anything malformed leaves the model unavailable; it never
# stops the API starting.
GOOGLE_GEMINI_CREDENTIALS=
# Quota attribution for a user OAuth credential (x-goog-user-project). Google
# cannot tell which project's free allowance a call belongs to without it. The
# credential may name its own quota project; this setting wins.
GOOGLE_GEMINI_PROJECT_ID=
# Unset uses gemini-3.6-flash, verified against the free tier. Check with
# `pnpm model:verify` before changing it: free capacity differs per model, and
# several Flash models answer 503 far more often than they answer.
GEMINI_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# OpenRouter — the fallback. Kept, and not the primary.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_APP_NAME=LeRoutier
OPENROUTER_APP_URL=
# A locally-run MiniCPM or any OpenAI-compatible server. No key required.
LOCAL_MODEL_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_MODEL_NAME=minicpm
AGENT_MODEL_TIMEOUT_MS=20000
# Hard ceilings, not guidance. Free capacity is shared and exhaustible, so a
# runaway workflow must hit a wall. Duplicate situations reuse the previous
# conclusion instead of paying for it twice.
AGENT_MODEL_DAILY_CALLS=200
AGENT_MODEL_WORKFLOW_DAILY_CALLS=50
AGENT_MODEL_DEDUP_HOURS=6
# How long a provider is left alone after it says no. A quota error means "not
# for a while"; retrying into it spends the next window too. Measured: the
# Gemini free tier returns 429 after a handful of calls in quick succession, so
# treat its capacity as opportunistic rather than guaranteed.
#
# This is only the fallback guess. When Google says how long to wait — in a
# Retry-After header or a RetryInfo detail — that is believed instead, in both
# directions. The window is shared through the database, so a cold serverless
# instance does not call a provider that has already refused.
AGENT_MODEL_COOLDOWN_MINUTES=10
AGENT_MODEL_FAILURES_BEFORE_COOLDOWN=3
# The deterministic gate in front of incident triage — the only workflow that
# asks a model anything. Below these, an incident is handled deterministically
# and no remote call is made at all. "How late is late" is an operator's
# judgement, so these are settings rather than constants.
AGENT_TRIAGE_MIN_DELAY_MINUTES=15
AGENT_TRIAGE_MIN_STATIONARY_MINUTES=10

# Server only: existing API database schema and allowed frontend origins
DATABASE_SCHEMA=leroutier
CORS_ORIGINS=
ALLOW_DEMO_LOGIN=false

# Firebase Authentication (Google Sign-In). Server-side, on le-routier-api.
# All four are browser-facing identifiers — every Firebase web app ships them —
# and are served to the PWA at runtime by /api/v1/auth/config, so rotating one
# is an API change rather than a rebuild. None belongs in a VITE_ variable.
#
# The issuer, audience and signing-key URL are DERIVED from the project id and
# are deliberately not configurable: a mistyped issuer or audience is what makes
# a verifier accept another project's tokens.
#
# Missing any of the four leaves production sign-in unavailable, by design.
# Use the project's Firebase-hosted auth domain (<project-id>.firebaseapp.com).
# A website domain is not interchangeable with an auth helper host. Authorize
# both leroutier.app and www.leroutier.app in Firebase Authentication settings.
# See packages/config/README.md for the production configuration and checks.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
#
# NOT USED and NOT STORED: a Firebase service-account JSON. Verifying an ID
# token needs only the project id and Google's public keys, so no private key
# exists anywhere in this system. There is no OAuth client secret either: a
# browser application cannot keep one.

# One-time administrator CLI only. Keep identifiers in an ignored env file.
# BOOTSTRAP_CONFIRM must be provision-first-operator to execute.
BOOTSTRAP_CONFIRM=
BOOTSTRAP_OPERATOR_KEY=
BOOTSTRAP_OPERATOR_NAME=
BOOTSTRAP_OPS_SUBJECT=
BOOTSTRAP_OPS_NAME=
BOOTSTRAP_PLATFORM_OPS=false
BOOTSTRAP_DRIVER_SUBJECT=
BOOTSTRAP_DRIVER_NAME=
BOOTSTRAP_DRIVER_LICENSE=

# Road routing engine (OSRM-compatible HTTP API). Unset means routes simply have
# no road geometry and every surface says so — a straight line is never drawn as
# a road. Public OSRM/Valhalla demo servers forbid production use, so point this
# at an engine you run or are entitled to use (self-hosted OSRM with a Benin
# extract is the recommended pilot path).
ROUTING_URL=
ROUTING_PROVIDER=osrm
ROUTING_API_KEY=
ROUTING_TIMEOUT_MS=15000
