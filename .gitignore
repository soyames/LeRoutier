# dependencies
node_modules/
.pnpm-store/

# builds
.next/
dist/
build/
coverage/
playwright-report/
test-results/

# environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
# Credential exports must never enter this repository.
leroutier-db.txt
# Backblaze's own download names the bucket, and the file it produces carries
# the account's master application key — the one credential that can delete
# buckets and mint further keys. Matched by its download pattern so a file
# dragged in from Downloads cannot be committed by a routine `git add -A`.
Backblaze-*.txt
*b2-master*
*application-key*.txt
# Provider credential exports: Firebase service accounts and Google OAuth
# clients. Named by their own download patterns so a file dragged in from
# Downloads cannot be committed by a routine `git add -A`.
*firebase-adminsdk*.json
client_secret_*.json
*service-account*.json
application_default_credentials.json
.fb-*

# local databases / caches
*.sqlite
*.sqlite3
.cache/
.tmp/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# deployment
.vercel/
.wrangler/
.vercel
.env*
!.env.example

# Agent worktrees and local session scratch. A worktree under the repo root
# is a second checkout of this same project; linting or committing it would
# duplicate every file in the tree.
.claude/

# Repository policy: project documentation is kept outside GitHub.
# A tracked file under docs/ is a violation; scripts/check-repo-policy.mjs
# fails the build on it (CI included), so no clone can silently reintroduce it.
/docs/
