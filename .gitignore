test-results/

# environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
# Credential exports must never enter this repository.
leroutier-db.txt
# Provider credential exports: Firebase service accounts and Google OAuth
# clients. Named by their own download patterns so a file dragged in from
# Downloads cannot be committed by a routine `git add -A`.
*firebase-adminsdk*.json
client_secret_*.json
*service-account*.json
application_default_credentials.json
.fb-*

# local databases / caches
*.sqlite
*.sqlite3
.cache/
.tmp/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# deployment
.vercel/
.wrangler/
.vercel
.env*
!.env.example

# Agent worktrees and local session scratch. A worktree under the repo root
# is a second checkout of this same project; linting or committing it would
# duplicate every file in the tree.
.claude/

# Project documentation IS version controlled and travels with the repository.
# Only genuinely local material is excluded, and it is excluded by name rather
# than by directory: a blanket `docs/` rule lived in .git/info/exclude, where
# it was invisible to everyone else and quietly kept legitimate documentation
# out of the repository on one machine only.
#
# Put machine-specific notes, scratch investigations and anything carrying
# production internals under docs/local/ or name it *.local.md.
docs/local/
docs/**/*.local.md
